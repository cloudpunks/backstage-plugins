{
  "name": "@cloudpunks/backstage-plugin-scaffolder-kubernetes-versions",
  "version": "1.0.0",
  "description": "Backstage scaffolder field to pick a Kubernetes or k0s version",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudpunks/backstage-plugins.git",
    "directory": "plugins/scaffolder-kubernetes-versions"
  },
  "homepage": "https://github.com/cloudpunks/backstage-plugins/tree/main/plugins/scaffolder-kubernetes-versions",
  "bugs": "https://github.com/cloudpunks/backstage-plugins/issues",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "scaffolder",
    "kubernetes",
    "k0s"
  ],
  "sideEffects": false,
  "backstage": {
    "role": "frontend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder",
    "pluginPackages": [
      "@cloudpunks/backstage-plugin-kubernetes-versions-backend",
      "@cloudpunks/backstage-plugin-scaffolder-kubernetes-versions"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/core-plugin-api": "^1.12.10",
    "@backstage/frontend-plugin-api": "^0.18.1",
    "@backstage/plugin-scaffolder-react": "^2.1.0",
    "@mui/material": "^5.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/frontend-test-utils": "^0.6.4",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "files": [
    "dist"
  ]
}
