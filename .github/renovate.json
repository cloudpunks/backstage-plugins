{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>cloudpunks/.github//renovate/preset",
    ":preserveSemverRanges"
  ],
  "ignoreDeps": [
    "express",
    "react-dom",
    "react-router",
    "react",
    "@material-ui/core",
    "@material-ui/icons",
    "@types/express",
    "@types/react-dom",
    "@types/react"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "@backstage/*"
      ],
      "enabled": false
    }
  ]
}
