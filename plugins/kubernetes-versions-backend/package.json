{
  "name": "@cloudpunks/backstage-plugin-kubernetes-versions-backend",
  "version": "1.0.0",
  "description": "Backstage backend plugin listing the supported Kubernetes and k0s releases",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudpunks/backstage-plugins.git",
    "directory": "plugins/kubernetes-versions-backend"
  },
  "homepage": "https://github.com/cloudpunks/backstage-plugins/tree/main/plugins/kubernetes-versions-backend",
  "bugs": "https://github.com/cloudpunks/backstage-plugins/issues",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "kubernetes",
    "k0s"
  ],
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "kubernetes-versions",
    "pluginPackages": [
      "@cloudpunks/backstage-plugin-kubernetes-versions-backend",
      "@cloudpunks/backstage-plugin-scaffolder-kubernetes-versions"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/errors": "^1.3.1",
    "express": "^5.0.0",
    "express-promise-router": "^4.1.1"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.7",
    "@backstage/cli": "^0.36.6",
    "@types/express": "^5.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts"
}
