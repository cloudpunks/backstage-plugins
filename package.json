{
  "name": "backstage-plugins",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build:all": "backstage-cli repo build --all",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "config": "backstage-cli config:check --lax --strict",
    "config:all": "backstage-cli config:check --lax --strict --config app-config.yaml",
    "new": "backstage-cli new"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "Apache-2.0"
        },
        "templates": [
          "@backstage/cli/templates/new-frontend-plugin",
          "@backstage/cli/templates/new-frontend-plugin-module",
          "@backstage/cli/templates/backend-plugin",
          "@backstage/cli/templates/backend-plugin-module"
        ]
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/cli-defaults": "^0.1.6",
    "@jest/environment-jsdom-abstract": "~30.5.0",
    "@testing-library/dom": "^9.0.0",
    "@types/jest": "^30.0.0",
    "jest": "~30.5.0",
    "jsdom": "^30.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.9.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "packageManager": "yarn@4.18.1"
}
